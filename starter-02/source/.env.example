# PILOT STARTER — non-secret example configuration. Copy to .env before `npm run dev` / `npm run build`:
#   cp .env.example .env
# The upstream build refuses to start without these two names. In this starter they are deliberately
# unusable placeholders: src/lib/supabase.js is replaced by a synthetic in-memory client, the network
# guard and the page's Content-Security-Policy block every external request, and `.invalid` can never
# resolve. Never put a real URL, key or token here.
VITE_SUPABASE_URL=https://pilot-starter.invalid
VITE_SUPABASE_ANON_KEY=pilot-starter-placeholder-not-a-key
